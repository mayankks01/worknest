# Local development only. Copy to .env. Never use these values on a public host.
DJANGO_SECRET_KEY=local-development-only-change-before-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_APP_URL=http://localhost:5173
POSTGRES_DB=worknest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-postgres-password
DATABASE_OWNER=worknest_owner
DATABASE_OWNER_PASSWORD=local-owner-password
DATABASE_USER=worknest_app
DATABASE_PASSWORD=local-app-password
DATABASE_HOST=localhost
DATABASE_PORT=55432
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_FROM=WorkNest <noreply@worknest.local>
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=worknest-private
S3_REGION=us-east-1
S3_ACCESS_KEY=worknest-local
S3_SECRET_KEY=local-storage-password
